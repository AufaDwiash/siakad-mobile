<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Offline-First Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- CameraX + ML Kit QR Presensi & Document Upload PMB -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Geolocation Validation for Campus Attendance -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Biometric Authentication (Fingerprint / Face Unlock) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Push Notifications (FCM) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".SiakadApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_alyasini_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_alyasini_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SiakadAlYasini"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SiakadAlYasini"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
